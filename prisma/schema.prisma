// Baax Stay – Datenmodell Phase 0
// Phase-1-Modelle (Mandate, SearchProfile, Property, Match, Fee*, ...) folgen nach Abnahme Phase 0.

generator client {
  provider      = "prisma-client-js"
  // Im Docker-Image ist OpenSSL 3 installiert, beim Bauen aber noch nicht: beide Varianten erzeugen
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LEITUNG
  MITARBEITER
  PRAKTIKANT
}

enum LeadSource {
  MESSE
  AGENTUR
  MULTIPLIKATOR
  WEBSITE
  EMPFEHLUNG
  LINKEDIN
  BESTAND
  SONSTIGES
}

enum LeadStatus {
  NEU
  KONTAKTIERT
  ERSTGESPRAECH
  UMGEWANDELT
  VERWORFEN
}

enum LeadRole {
  KAEUFER
  VERKAEUFER
  PARTNER
  MULTIPLIKATOR
}

enum Segment {
  FEWO
  APARTMENTHAUS
  PENSION_HOTEL
}

enum HubSync {
  PENDING
  SYNCED
  FAILED
}

model Lead {
  id               String     @id @default(cuid())
  clientId         String?    @unique // Idempotenz für Offline-Nachsendung
  hubContactId     String?
  hubSync          HubSync    @default(PENDING)
  hubSyncError     String?
  hubSyncedAt      DateTime?
  duplicateOfId    String?
  duplicateOf      Lead?      @relation("LeadDuplicates", fields: [duplicateOfId], references: [id])
  duplicates       Lead[]     @relation("LeadDuplicates")
  name             String
  company          String?
  email            String?
  phone            String?
  phoneNorm        String? // nur Ziffern mit Ländervorwahl, für die Dubletten-Prüfung
  role             LeadRole   @default(KAEUFER)
  source           LeadSource
  sourceDetail     String?
  referrerId       String?
  interest         String?
  segment          Segment?
  regions          String[]   @default([])
  budgetMin        Int?
  budgetMax        Int?
  consentEmail     Boolean    @default(false)
  consentAt        DateTime?
  status           LeadStatus @default(NEU)
  note             String?
  followUpTaskAt   DateTime? // Aufgabe „Nachfassen“ im Hub angelegt (Lead ohne Kontakt nach 2 Werktagen)
  createdById      String // Hub-User-ID oder "public" für das Interessenformular
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  mandate          Mandate?
  sellerProperties Property[] @relation("SellerLeadProperties")

  @@index([email])
  @@index([phoneNorm])
  @@index([status])
  @@index([source])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Region {
  id              String    @id @default(cuid())
  country         String // ISO 3166-1 alpha-2
  key             String    @unique // z. B. "es-mallorca"
  name            String
  focus           Boolean   @default(false)
  licenseRule     String?
  // Phase 3: Regionswissen
  description     String?
  rentalRules     String? // ausführlich: touristische Vermietung, Lizenzen, Registrierung
  secondHomeRules String? // Zweitwohnsitz, Grundverkehr, Erwerb durch Ausländer
  taxNote         String?
  seasonality     String?
  pricePerSqmMin  Int?
  pricePerSqmMax  Int?
  occupancyMin    Float?
  occupancyMax    Float?
  adrMin          Int?
  adrMax          Int?
  airportNote     String?
  risks           String?
  sources         String?
  reviewedAt      DateTime?
  reviewedByName  String?

  @@index([country])
}

// Schlüssel-Wert-Einstellungen, z. B. aktives Event für die Lead-Erfassung
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ---------------------------------------------------------------------------
// Phase 1 – Kern
// ---------------------------------------------------------------------------

enum MandateStatus {
  ERSTGESPRAECH
  BEAUFTRAGT
  ANALYSE
  SUCHE
  PRUEFUNG
  VERHANDLUNG
  GEKAUFT
  NACHBETREUUNG
  ABGESCHLOSSEN
  PAUSIERT
  BEENDET_OHNE_KAUF
}

enum UsageGoal {
  RENDITE
  EIGENNUTZUNG
  KOMBINIERT
  EIGENBETRIEB
}

enum ObjectSource {
  PARTNER
  AGENTUR
  PORTAL
  OFFMARKET
  DIREKT
}

enum LicenseStatus {
  VORHANDEN
  BEANTRAGT
  FEHLT
  UNKLAR
  NICHT_NOETIG
}

enum LicenseLight {
  GRUEN
  GELB
  ROT
  GRAU
}

enum Availability {
  VERFUEGBAR
  RESERVIERT
  VERKAUFT
  ZURUECKGEZOGEN
}

enum MatchStatus {
  NEU
  GEPRUEFT
  AN_KAEUFER
  ABGELEHNT
  GEMERKT
  GESCHLOSSEN
}

enum ReferrerType {
  TIPPGEBER
  AGENTUR
  MULTIPLIKATOR
  PARTNER
}

enum PartnerType {
  MAKLER
  AGENTUR
  ANWALT
  NOTAR
  FINANZIERER
  SONSTIGES
}

enum OfferResponse {
  OFFEN
  ANGENOMMEN
  ABGELEHNT
  GEGENANGEBOT
}

enum DocumentKind {
  SUCHAUFTRAG
  GWG_NACHWEIS
  FINANZIERUNG
  VOLLMACHT
  SONSTIGES
}

model Mandate {
  id                String         @id @default(cuid())
  leadId            String?        @unique
  lead              Lead?          @relation(fields: [leadId], references: [id])
  hubContactId      String? // Käufer im Hub; leer, solange die Hub-Schnittstelle nicht steht
  buyerName         String // Anzeigename des Käufers (Kopie aus Lead/Hub)
  buyerEmail        String?
  buyerPhone        String?
  title             String
  status            MandateStatus  @default(ERSTGESPRAECH)
  ownerId           String
  ownerName         String?
  ownerEmail        String?
  ownerPhone        String? // Ansprechpartner im Käuferportal
  ownerPhotoFileId  String?
  buyerLang         String         @default("de") // de | en für Portal, Dossier, Mails
  portalNextSteps   String? // Freitext „nächste Schritte“ im Portal
  startDate         DateTime?
  endDate           DateTime?
  endReason         String?
  statusBeforePause MandateStatus?
  contractSignedAt  DateTime?
  gwgIdentifiedAt   DateTime?
  gwgIdentType      String?
  interviewNotes    Json?
  assessment        String? // Einschätzung: realistisch ja / nein / mit Anpassung
  referrerId        String?
  referrer          Referrer?      @relation(fields: [referrerId], references: [id])
  note              String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  profile          SearchProfile?
  fee              FeeAgreement?
  matches          Match[]
  events           MandateEvent[]
  presentations    Presentation[]
  offers           Offer[]
  closing          Closing?
  followUps        FollowUp[]
  documents        MandateDocument[]
  rewards          ReferralReward[]
  partnerSends     PartnerSend[]
  portalAccesses   PortalAccess[]
  reports          Report[]
  notifications    BuyerNotification[]
  inspections      Inspection[]
  trips            Trip[]
  partnerRatings   PartnerRating[]
  portalSearches   PortalSearch[]
  searchCandidates SearchCandidate[]

  @@index([status])
  @@index([ownerId])
}

model SearchProfile {
  id              String    @id @default(cuid())
  mandateId       String    @unique
  mandate         Mandate   @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  segments        Segment[]
  countries       String[]  @default([])
  regions         String[]  @default([]) // Region-Keys
  priceMin        Int?
  priceMax        Int
  usageGoal       UsageGoal @default(RENDITE)
  minUnits        Int?
  maxUnits        Int?
  licenseRequired Boolean   @default(true)
  mustCriteria    Json      @default("[]") // string[]
  wishCriteria    Json      @default("[]") // { key, weight }[]
  financing       String?
  horizon         String?
  active          Boolean   @default(true)
  updatedAt       DateTime  @updatedAt
}

model Property {
  id               String        @id @default(cuid())
  title            String
  segment          Segment
  country          String
  region           String // Region-Key
  locality         String?
  address          String?
  price            Int
  currency         String        @default("EUR")
  units            Int?
  livingArea       Int?
  licenseStatus    LicenseStatus @default(UNKLAR)
  licenseNote      String?
  licenseLight     LicenseLight  @default(GRAU)
  occupancyPct     Float?
  adr              Int?
  revenueYear      Int?
  features         Json          @default("[]") // string[]
  description      String?
  titleEn          String?
  descriptionEn    String?
  // Phase 1b: Gesamtkosten, Rendite, Dossier
  renovationBudget Int?
  opCostsYear      Int? // Betriebskosten p. a. (Nebenkosten, Versicherung, Instandhaltung)
  managementPct    Float? // Verwaltung/Agentur in % vom Umsatz
  reservesPct      Float? // Rücklagen in % vom Umsatz
  taxPct           Float? // Steuern grob in % vom Überschuss
  scenarioSpread   Float? // Szenario-Spanne, Standard 0,15
  strengths        String?
  risks            String?
  strengthsEn      String?
  risksEn          String?
  precheckNote     String? // Vorprüfungsstand
  source           ObjectSource
  sourceDetail     String?
  knownSince       DateTime      @default(now())
  knownSourceNote  String?
  sellerLeadId     String?
  sellerLead       Lead?         @relation("SellerLeadProperties", fields: [sellerLeadId], references: [id])
  offmarket        Boolean       @default(false)
  referrerId       String?
  referrer         Referrer?     @relation(fields: [referrerId], references: [id])
  partnerId        String?
  partner          Partner?      @relation(fields: [partnerId], references: [id])
  availability     Availability  @default(VERFUEGBAR)
  priceHistory     Json          @default("[]") // { price, at, note? }[]
  documents        Json          @default("[]") // StoredFile-IDs
  photos           Json          @default("[]") // StoredFile-IDs
  duplicateOfId    String?
  duplicateOf      Property?     @relation("PropertyDuplicates", fields: [duplicateOfId], references: [id])
  duplicates       Property[]    @relation("PropertyDuplicates")
  active           Boolean       @default(true)
  createdById      String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  matches              Match[]
  presentations        Presentation[]
  offers               Offer[]
  precheck             Precheck?
  inspections          Inspection[]
  submittedViaAccessId String? // Einreichung über Partnerzugang
  searchCandidates     SearchCandidate[]

  @@index([country, region])
  @@index([segment])
  @@index([availability])
}

model Match {
  id                  String      @id @default(cuid())
  mandateId           String
  propertyId          String
  mandate             Mandate     @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  property            Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  score               Int
  nearMiss            Boolean     @default(false)
  reasons             Json // { passt: string[], fehlt: string[], knapp: string[] }
  status              MatchStatus @default(NEU)
  rejectReason        String?
  viewingAt           DateTime?
  viewingNote         String?
  notifiedAt          DateTime?
  approvedById        String? // Freigabe Leitung für Vorstellung an nachrangigen Käufer
  approvedAt          DateTime?
  buyerAction         String? // Käuferportal: GEMERKT, ABGELEHNT, BESICHTIGUNG
  buyerReasonCategory String?
  buyerReasonText     String?
  buyerActionAt       DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([mandateId, propertyId])
  @@index([status])
  @@index([notifiedAt])
}

model Presentation {
  id             String    @id @default(cuid())
  mandateId      String
  propertyId     String
  mandate        Mandate   @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  channel        String // PORTAL, EMAIL, DOSSIER, VOR_ORT
  askingPrice    Int
  sentById       String
  sentAt         DateTime  @default(now())
  viewedAt       DateTime?
  priorKnowledge Boolean   @default(false) // Objekt war vor Beginn des Suchauftrags bekannt

  @@unique([mandateId, propertyId])
}

model FeeBand {
  id          String  @id @default(cuid())
  volumeFrom  Int
  volumeTo    Int?
  baseFee     Int
  successFee  Int
  bonusPct    Float   @default(0.10)
  bonusCapPct Float   @default(0.25)
  note        String?

  @@index([volumeFrom])
}

model FeeAgreement {
  id                   String    @id @default(cuid())
  mandateId            String    @unique
  mandate              Mandate   @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  volumeBandId         String?
  baseFeeActive        Boolean   @default(false)
  baseFee              Int       @default(0)
  successFee           Int       @default(0)
  bonusPct             Float     @default(0.10)
  bonusCapPct          Float     @default(0.25)
  travelFlat           Int?
  sellerSideCommission Int?
  sellerSideCredited   Int?
  note                 String?
  purchasePrice        Int?
  askingPrice          Int? // eingefrorener Angebotspreis des gekauften Objekts
  bonusAmount          Int?
  invoicedAt           DateTime?
  paidAt               DateTime?
  updatedAt            DateTime  @updatedAt
}

model MandateEvent {
  id        String   @id @default(cuid())
  mandateId String
  mandate   Mandate  @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  type      String
  payload   Json     @default("{}")
  userId    String
  userName  String?
  createdAt DateTime @default(now())

  @@index([mandateId, createdAt])
}

model Referrer {
  id           String       @id @default(cuid())
  hubContactId String?
  name         String
  company      String?
  email        String?
  phone        String?
  type         ReferrerType
  rewardRule   String?
  rewardPct    Float? // Anteil am Netto-Erfolgshonorar, falls prozentual
  rewardFlat   Int? // fester Betrag, falls pauschal
  active       Boolean      @default(true)
  note         String?
  createdAt    DateTime     @default(now())

  rewards    ReferralReward[]
  mandates   Mandate[]
  properties Property[]
}

model ReferralReward {
  id         String    @id @default(cuid())
  referrerId String
  referrer   Referrer  @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  mandateId  String
  mandate    Mandate   @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  amount     Int
  basis      String? // Berechnungsgrundlage als Text
  dueAt      DateTime?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
}

model Partner {
  id              String      @id @default(cuid())
  hubContactId    String?
  name            String
  company         String?
  email           String?
  phone           String?
  language        String      @default("de") // de | en
  type            PartnerType @default(MAKLER)
  country         String
  regions         String[]    @default([])
  licenseNote     String?
  commissionSplit String?
  agreementAt     DateTime?
  active          Boolean     @default(true)
  note            String?
  createdAt       DateTime    @default(now())

  properties Property[]
  sends      PartnerSend[]
  accesses   PartnerAccess[]
  ratings    PartnerRating[]
}

// Versand eines anonymisierten Suchprofils an einen Partner
model PartnerSend {
  id        String    @id @default(cuid())
  mandateId String
  partnerId String
  mandate   Mandate   @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  partner   Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  sentById  String
  sentAt    DateTime  @default(now())
  language  String
  subject   String
  body      String
  repliedAt DateTime?
  replyNote String?
}

model Offer {
  id            String        @id @default(cuid())
  mandateId     String
  propertyId    String
  mandate       Mandate       @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amount        Int
  madeAt        DateTime
  conditions    String?
  response      OfferResponse @default(OFFEN)
  counterAmount Int?
  note          String?
  createdById   String
  createdAt     DateTime      @default(now())

  @@index([mandateId, madeAt])
}

model Closing {
  id           String    @id @default(cuid())
  mandateId    String    @unique
  mandate      Mandate   @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  propertyId   String
  country      String
  checklist    Json // { key, label, done, doneAt?, dueAt?, hubTaskAt?, note? }[]
  notaryDate   DateTime?
  handoverDate DateTime?
  updatedAt    DateTime  @updatedAt
}

model FollowUp {
  id                String    @id @default(cuid())
  mandateId         String
  mandate           Mandate   @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  dueAt             DateTime
  doneAt            DateTime?
  feedback          String?
  referralGiven     Boolean   @default(false)
  nextMandateWanted Boolean   @default(false)
  hubTaskAt         DateTime?
}

model StoredFile {
  id           String   @id @default(cuid())
  fileName     String // Originalname (nur Anzeige)
  storedName   String   @unique // zufälliger Name auf dem Volume
  mimeType     String
  size         Int
  entity       String // Property, Mandate
  entityId     String
  kind         String? // PHOTO, DOCUMENT, SUCHAUFTRAG, ...
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([entity, entityId])
}

model MandateDocument {
  id           String       @id @default(cuid())
  mandateId    String
  mandate      Mandate      @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  kind         DocumentKind
  fileId       String
  label        String?
  uploadedById String
  uploadedAt   DateTime     @default(now())
}

// Gespeicherte Filter je Nutzer
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  scope     String // leads | auftraege | objekte | partner | tippgeber
  name      String
  query     String // Querystring
  createdAt DateTime @default(now())

  @@index([userId, scope])
}

// ---------------------------------------------------------------------------
// Phase 1b – Kundenerlebnis
// ---------------------------------------------------------------------------

enum ReportKind {
  SUCHBERICHT
  MARKTBERICHT
}

enum ReportStatus {
  ENTWURF
  FREIGEGEBEN
}

enum NotificationKind {
  OBJEKT
  BERICHT
  STATUS
  SONSTIGES
}

enum NotificationStatus {
  ENTWURF
  GESENDET
  VERWORFEN
}

// Kaufnebenkosten je Land bzw. Region (Richtwerte, gepflegt von Leitung)
model CountryCost {
  id        String   @id @default(cuid())
  country   String
  regionKey String? // regionale Abweichung ersetzt den Landeswert mit gleicher Bezeichnung
  label     String
  pct       Float? // Anteil am Kaufpreis in Prozent
  flat      Int? // fester Betrag in EUR
  note      String?
  validFrom DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country, regionKey])
}

// Wechselkurse für Vergleiche (z. B. CHF)
model FxRate {
  id        String   @id @default(cuid())
  currency  String
  rateToEur Float // 1 Einheit Fremdwährung = rateToEur EUR
  source    String   @default("manuell")
  fetchedAt DateTime @default(now())

  @@index([currency, fetchedAt])
}

// Persönlicher Magic Link zum Käuferportal (Token nur gehasht gespeichert)
model PortalAccess {
  id          String    @id @default(cuid())
  mandateId   String
  mandate     Mandate   @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastSeenAt  DateTime?
  viewCount   Int       @default(0)
  sentTo      String?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([mandateId])
}

// Suchbericht und Marktbericht als Entwurf mit Freigabe
model Report {
  id           String       @id @default(cuid())
  mandateId    String
  mandate      Mandate      @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  kind         ReportKind
  status       ReportStatus @default(ENTWURF)
  title        String
  periodStart  DateTime?
  periodEnd    DateTime?
  content      Json
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  approvedById String?
  approvedAt   DateTime?

  @@index([mandateId, kind])
}

// Benachrichtigungen an Käufer: immer Entwurf, Versand nur nach Sichtung durch Mitarbeiter
model BuyerNotification {
  id        String             @id @default(cuid())
  mandateId String
  mandate   Mandate            @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  status    NotificationStatus @default(ENTWURF)
  subject   String
  body      String
  payload   Json               @default("{}")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  sentAt    DateTime?
  sentById  String?
  sentTo    String?

  @@index([mandateId, status])
}

// ---------------------------------------------------------------------------
// Phase 2
// ---------------------------------------------------------------------------

enum InspectionStatus {
  ENTWURF
  ABGESCHLOSSEN
}

enum Recommendation {
  EMPFEHLEN
  BEDINGT
  NICHT_EMPFEHLEN
}

enum PrecheckStatus {
  OFFEN
  LAEUFT
  OK
  BEDENKEN
  KO
}

// Besichtigungsprotokoll (mobil am Objekt)
model Inspection {
  id             String           @id @default(cuid())
  propertyId     String
  property       Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  mandateId      String?
  mandate        Mandate?         @relation(fields: [mandateId], references: [id], onDelete: SetNull)
  tripId         String?
  trip           Trip?            @relation(fields: [tripId], references: [id], onDelete: SetNull)
  date           DateTime         @default(now())
  attendees      String?
  status         InspectionStatus @default(ENTWURF)
  rating         Int? // Gesamteindruck 1–5
  recommendation Recommendation?
  items          Json             @default("[]") // { key, label, rating, note }[]
  notes          String?
  photos         Json             @default("[]") // StoredFile-IDs
  createdById    String
  createdByName  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([propertyId])
  @@index([mandateId])
}

// Reise je Suchauftrag mit Kosten
model Trip {
  id          String       @id @default(cuid())
  mandateId   String
  mandate     Mandate      @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  title       String
  destination String?
  startDate   DateTime
  endDate     DateTime?
  travelers   String?
  billable    Boolean      @default(true) // zählt für die Reisepauschale des Käufers
  note        String?
  createdById String
  createdAt   DateTime     @default(now())
  costs       TripCost[]
  inspections Inspection[]

  @@index([mandateId])
}

model TripCost {
  id            String   @id @default(cuid())
  tripId        String
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category      String // FLUG, BAHN, AUTO, MIETWAGEN, HOTEL, VERPFLEGUNG, SONSTIGES
  description   String?
  amount        Int // EUR
  date          DateTime @default(now())
  receiptFileId String?
  createdAt     DateTime @default(now())
}

// Vorprüfung je Objekt (Checkliste je Segment und Land)
model Precheck {
  id          String         @id @default(cuid())
  propertyId  String         @unique
  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  status      PrecheckStatus @default(OFFEN)
  items       Json // { key, label, group, status, note, doneAt }[]
  summary     String?
  updatedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// Zugangslink für Partner (Konzept: AccessLink)
model PartnerAccess {
  id          String    @id @default(cuid())
  partnerId   String
  partner     Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  mandateId   String? // optional auf einen Suchauftrag beschränkt
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastSeenAt  DateTime?
  viewCount   Int       @default(0)
  createdById String
  createdAt   DateTime  @default(now())

  @@index([partnerId])
}

// Bewertung eines Partners nach Zusammenarbeit
model PartnerRating {
  id          String   @id @default(cuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  mandateId   String?
  mandate     Mandate? @relation(fields: [mandateId], references: [id], onDelete: SetNull)
  reliability Int // 1–5
  quality     Int // Objektqualität, 1–5
  speed       Int // Reaktionszeit, 1–5
  comment     String?
  ratedById   String
  ratedByName String?
  createdAt   DateTime @default(now())

  @@index([partnerId])
}

// Vorlagen aus Datensatz (Suchauftrag, Partnervereinbarung, Tippgeberbestätigung)
model DocumentTemplate {
  id          String   @id @default(cuid())
  kind        String // SUCHAUFTRAG, PARTNERVEREINBARUNG, TIPPGEBERBESTAETIGUNG
  lang        String   @default("de")
  name        String
  body        String // Text mit {{platzhalter}}
  version     Int      @default(1)
  active      Boolean  @default(true)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([kind, lang])
}

// Kriterienkatalog (Phase 2: pflegbar)
model Criterion {
  key     String  @id
  label   String
  labelEn String?
  group   String
  active  Boolean @default(true)
  sort    Int     @default(0)
}

// Einmalige Erinnerungen (gegen doppelten Versand)
model ReminderLog {
  id     String   @id @default(cuid())
  key    String   @unique
  sentAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Phase 3
// ---------------------------------------------------------------------------

// Länderwissen (Kaufablauf, Erwerb durch Ausländer, Steuern)
model Country {
  code            String    @id // ISO 3166-1 alpha-2
  name            String
  nameEn          String?
  currency        String    @default("EUR")
  overview        String?
  buyingProcess   String?
  foreignBuyers   String?
  taxesNote       String?
  typicalDuration String?
  financingNote   String?
  sources         String?
  reviewedAt      DateTime?
  reviewedByName  String?
  updatedAt       DateTime  @updatedAt
}

enum CandidateStatus {
  NEU
  UEBERNOMMEN
  VERWORFEN
}

// Suchwunsch, den der Käufer im Portal speichert; erzeugt Kandidaten, nie direkt Treffer
model PortalSearch {
  id         String            @id @default(cuid())
  mandateId  String
  mandate    Mandate           @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  name       String
  segments   Segment[]
  countries  String[]          @default([])
  regions    String[]          @default([])
  priceMin   Int?
  priceMax   Int
  minUnits   Int?
  features   String[]          @default([])
  note       String?
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  candidates SearchCandidate[]

  @@index([mandateId])
}

model SearchCandidate {
  id             String          @id @default(cuid())
  portalSearchId String
  portalSearch   PortalSearch    @relation(fields: [portalSearchId], references: [id], onDelete: Cascade)
  mandateId      String
  mandate        Mandate         @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  score          Int
  reasons        Json
  status         CandidateStatus @default(NEU)
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime        @default(now())

  @@unique([portalSearchId, propertyId])
  @@index([mandateId, status])
}
