# --- Datenbank ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stay?schema=public"

# --- App ---
APP_URL="http://localhost:3000"
# Mindestens 32 Zeichen; signiert das Session-Cookie von Baax Stay
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"

# --- Baax Hub (Anmeldung und API, siehe docs/APP-ANBINDUNG.md im Hub) ---
# Adresse des Hubs = Aussteller (Issuer) der Anmeldung
HUB_URL="https://hub.baax.de"
# Aus dem Hub: Apps → Baax Stay → Anmeldung über den Hub (Geheimnis wird nur einmal angezeigt)
HUB_CLIENT_ID=""
HUB_CLIENT_SECRET=""
# Aus dem Hub: Einstellungen → API-Zugänge (beginnt mit bhub_, Schreibrechte); leer = Leads bleiben „ausstehend“
HUB_API_TOKEN=""
# Token, mit dem der Hub /api/hub/status abfragt (im Hub an der App hinterlegt)
HUB_STATUS_TOKEN=""
# Nur falls die API woanders liegt; leer = {HUB_URL}/api/v1
HUB_API_URL=""

# --- Entwicklung ---
# Nur lokal: erlaubt Login ohne Hub über /auth/dev (Rolle wählbar). Niemals in Produktion setzen.
AUTH_DEV_LOGIN="true"

# --- SMTP (Versand nach außen: Partner, tägliche Trefferübersicht) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM="Baax Immobilien GmbH <stay@baax.de>"
# Pflicht-HTML-Signatur der GmbH (als HTML, eine Zeile oder Datei-Pfad über MAIL_SIGNATURE_FILE)
MAIL_SIGNATURE_HTML=""
MAIL_SIGNATURE_FILE=""

# --- Cron (tägliche Jobs über GET /api/cron/daily mit Authorization: Bearer <CRON_SECRET>) ---
CRON_SECRET=""

# --- Uploads (Server-Volume) ---
UPLOAD_DIR="./uploads"

# --- PDF (Chromium für Playwright; leer = automatisch suchen) ---
CHROMIUM_PATH=""

# --- Benachrichtigungen ---
# Empfänger der täglichen Trefferübersicht, falls ein Verantwortlicher keine E-Mail im Token hat
MAIL_DIGEST_FALLBACK_TO=""
# Admin-Adresse für Fehlerberichte fehlgeschlagener Jobs (Hub-Übergabe, Mailversand)
ADMIN_EMAIL="mail@baax.de"
# Verworfene Leads nach n Monaten automatisch löschen (Löschkonzept)
RETENTION_DISCARDED_LEADS_MONTHS="12"

# --- Design ---
# Hausfarbe Baax-Cyan als Hex-Wert, z. B. "#19B5D4" (leer = Standard); helle und kräftige Variante werden abgeleitet
BRAND_COLOR=""

# --- Phase 1b ---
# URL, unter der der Server sich selbst erreicht (Dossier- und Berichts-PDF). Im Container: http://localhost:3000
INTERNAL_URL=""
# Quelle der Wechselkurse (Standard: EZB-Referenzkurse)
FX_SOURCE_URL="https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml"
