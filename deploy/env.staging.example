# Baax Stay – Staging. Kopieren nach .env.staging. Eigene Geheimnisse, eigener Hub-Client, kein Versand an echte Käufer (SMTP leer lassen oder Test-Postfach).
# Geheimnisse erzeugen: openssl rand -hex 32 (nur Buchstaben und Ziffern; Sonderzeichen würden die Datenbank-Adresse zerbrechen)

APP_URL=https://stay-staging.baax.de
# APP_VERSION setzt deploy/stay.sh automatisch auf den Git-Stand (Image-Tag für Rollback)

# Pflicht
POSTGRES_PASSWORD=
SESSION_SECRET=
CRON_SECRET=

# Baax Hub: Anmeldung und API (Werte aus dem Hub, siehe deploy/README.md „Anmeldung über den Hub“)
HUB_URL=https://hub.baax.de
HUB_CLIENT_ID=
HUB_CLIENT_SECRET=
HUB_API_TOKEN=
HUB_STATUS_TOKEN=

# Mailversand (Pflicht-Signatur der GmbH als HTML, eine Zeile)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Baax Immobilien GmbH <stay@baax.de>
MAIL_SIGNATURE_HTML=
ADMIN_EMAIL=mail@baax.de
MAIL_DIGEST_FALLBACK_TO=

# Erscheinungsbild: Primärfarbe (leer = Baax-Cyan #0cc0df wie im Hub)
BRAND_COLOR=

# Zeiten (HHMM, Europe/Berlin)
CRON_TIME=0730
BACKUP_TIME=0300
BACKUP_KEEP_DAYS=30

# Erreichbarkeit auf dem geteilten Server
# Variante A (Proxy auf dem Host): freier lokaler Port
STAY_HOST_PORT=3011
# Variante B (Proxy-Container): Name des vorhandenen Docker-Netzes und Domain
PROXY_NETWORK=proxy
STAY_ROUTER=baax-stay-staging
STAY_DOMAIN=stay-staging.baax.de
# Optional: Backups zusätzlich in Host-Verzeichnis
BACKUP_HOST_DIR=/srv/backups/baax-stay-staging
STAY_PROXY_MODE=port
