# Baax Stay – Produktion. Kopieren nach .env.production (nicht ins Repository!) und ausfüllen.
# Geheimnisse erzeugen: openssl rand -base64 48

APP_URL=https://stay.baax.de
APP_VERSION=1.0.0

# Pflicht
POSTGRES_PASSWORD=
SESSION_SECRET=
CRON_SECRET=

# Hub-Login und Hub-API (Endpunkte bestätigen)
HUB_URL=https://hub.baax.de
HUB_LOGIN_PATH=/sso/login
HUB_JWT_SECRET=
HUB_JWKS_URL=
HUB_JWT_ISSUER=
HUB_JWT_AUDIENCE=baax-stay
HUB_ROLE_CLAIM=role
HUB_API_URL=https://hub.baax.de/api
HUB_API_TOKEN=
HUB_CONTACTS_PATH=/contacts
HUB_TASKS_PATH=/tasks
HUB_APPOINTMENTS_PATH=/appointments

# Mailversand (Pflicht-Signatur der GmbH als HTML, eine Zeile)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Baax Immobilien GmbH <stay@baax.de>
MAIL_SIGNATURE_HTML=
ADMIN_EMAIL=mail@baax.de
MAIL_DIGEST_FALLBACK_TO=

# Erscheinungsbild: exakter Hex-Wert Baax-Cyan (leer = Platzhalter #19b5d4)
BRAND_COLOR=

# Zeiten (HHMM, Europe/Berlin)
CRON_TIME=0730
BACKUP_TIME=0300
BACKUP_KEEP_DAYS=30

# Erreichbarkeit auf dem geteilten Server
# Variante A (Proxy auf dem Host): freier lokaler Port
STAY_HOST_PORT=3010
# Variante B (Proxy-Container): Name des vorhandenen Docker-Netzes und Domain
PROXY_NETWORK=proxy
STAY_DOMAIN=stay.baax.de
# Optional: Backups zusätzlich in Host-Verzeichnis
BACKUP_HOST_DIR=/srv/backups/baax-stay
STAY_PROXY_MODE=port
